<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="mazeland-private" value="https://nuget.pkg.github.com/maze37/index.json" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="mazeland-private">
      <package pattern="Mazeland.*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <mazeland-private>
      <add key="Username" value="maze37" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </mazeland-private>
  </packageSourceCredentials>
</configuration>
